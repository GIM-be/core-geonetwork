  </xsl:template>

  <xsl:template match="srv:serviceType/gco:LocalName[$nodeType='Geopunt' or $nodeType='MercatorNet']" priority="1000">
    <xsl:variable name="localName">
      <xsl:choose>
        <xsl:when test=".='view en download'">view</xsl:when>
        <xsl:when test=".='Downloaddienst'">download</xsl:when>
        <xsl:when test=".='Raadpleegdienst'">view</xsl:when>
        <xsl:otherwise><xsl:value-of select="."/></xsl:otherwise>
      </xsl:choose>
    </xsl:variable>
    <gco:LocalName codeSpace="https://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType"><xsl:value-of select="$localName"/></gco:LocalName>
  </xsl:template>

  <xsl:template match="srv:serviceTypeVersion[$nodeType='Geopunt' or $nodeType='MercatorNet']" priority="1000"/>

  <xsl:template match="srv:coupledResource[$nodeType='Geopunt' or $nodeType='MercatorNet']" priority="1000"/>

  <xsl:template match="srv:operatesOn[$nodeType='Geopunt' or $nodeType='MercatorNet']" priority="1000">
